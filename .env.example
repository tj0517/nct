# Sanity — copy to .env.local and fill in.
# Both are NEXT_PUBLIC_*, i.e. exposed to the browser: never put a secret here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server-side only — a write token for scripts/import-content.mjs --write.
# Never NEXT_PUBLIC_, never committed, never bundled to the browser.
SANITY_WRITE_TOKEN=

# Contact form (NCT-1.01) — server-side only, connected at production launch (O-01).
# Without RESEND_API_KEY the form runs in dry-run mode locally and errors on production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
