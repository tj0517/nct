# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# playwright / ad-hoc debug screenshots — never commit these
.playwright-mcp/
*.png
!public/**/*.png
!src/**/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# Oryginały grafik od Anthony'ego — źródła, z których generujemy zasoby
# w public/images. Nie są serwowane i nie muszą jechać w repo.
/artwork/

# Filmy nauczycieli — hostowane w Sanity (scripts/upload-teacher-videos.mjs),
# nie w repo: 15 MB zostałoby w historii gita na zawsze. Lokalne kopie służą
# tylko do wgrania; oryginały sprzed przekodowania są w artwork/videos/.
/public/videos/
